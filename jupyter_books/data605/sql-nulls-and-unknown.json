{"version":3,"kind":"Notebook","sha256":"21919b1fa286992ae67659c00f9ff173e4e9b32c2c2ac00cec500b37e8565893","slug":"sql-nulls-and-unknown","location":"/../tutorials/tutorial_postgres/tutorial_university/sql_nulls_and_unknown.ipynb","dependencies":[],"frontmatter":{"title":"Aggregates","content_includes_title":true,"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"jupytext":{"formats":"ipynb,py:percent"},"numbering":{"title":{"offset":2}},"exports":[{"format":"ipynb","filename":"sql_nulls_and_unknown.ipynb","url":"/jupyter_books/data605/build/sql_nulls_and_unknow-53b734250c23e558a634f7bd7208df2a.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"This notebook covers how NULLs are handled and the results of different types of queries in presence of NULLs. Recall that NULL is a special value used when we don’t know the value of an attribute, which may be because the value is missing, it is inapplicable, or it is hidden. It is usually a bad idea to assign any specific meaning to the NULL value, but you should know how the query answers are affected.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yOdEcBAQZK"}],"key":"liiemV3gLm"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"NOTE:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UAma7wRWa3"}],"key":"g4ZOogMMLC"},{"type":"text","value":" NULLs are displayed as “None” by Jupyter, whereas ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"abuSsKHcT5"},{"type":"inlineCode","value":"psql","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YJgvN7etos"},{"type":"text","value":" just shows an empty space.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OgSHtnu1kU"}],"key":"ucqed7GGj9"}],"key":"u0DMB1HzYk"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-15T01:05:07.860336Z","start_time":"2024-02-15T01:05:07.809126Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"%load_ext sql\n%sql postgresql://postgres:postgres@localhost/university\n%config SqlMagic.style = '_DEPRECATED_DEFAULT'","key":"eRCedgM5Th"},{"type":"outputs","id":"3z82C8-NEbeGiB4uX9ECz","key":"zcrQgO3Swd","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The sql extension is already loaded. To reload it, use:\n  %reload_ext sql\n"},"children":[]}]}],"key":"iIVxmsVtH6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"## Let's create a simple table, with a few NULL values in it\n%sql drop table if exists R;\n%sql create table R (i int, j int);\n%sql insert into R values(10, 10), (10, 20), (10, null), (null, 20), (null, 30), (20, null);\n%sql select * from R;","key":"hexnxIWGmw"},{"type":"outputs","id":"tTXddi8veTi_gSR-CWpcK","key":"SdiGI5Fovh","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\nDone.\n * postgresql://postgres:***@localhost/university\nDone.\n * postgresql://postgres:***@localhost/university\n6 rows affected.\n * postgresql://postgres:***@localhost/university\n6 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":5,"metadata":{},"data":{"text/html":{"content":"<table>\n    <thead>\n        <tr>\n            <th>i</th>\n            <th>j</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>10</td>\n            <td>10</td>\n        </tr>\n        <tr>\n            <td>10</td>\n            <td>20</td>\n        </tr>\n        <tr>\n            <td>10</td>\n            <td>None</td>\n        </tr>\n        <tr>\n            <td>None</td>\n            <td>20</td>\n        </tr>\n        <tr>\n            <td>None</td>\n            <td>30</td>\n        </tr>\n        <tr>\n            <td>20</td>\n            <td>None</td>\n        </tr>\n    </tbody>\n</table>","content_type":"text/html"},"text/plain":{"content":"[(10, 10), (10, 20), (10, None), (None, 20), (None, 30), (20, None)]","content_type":"text/plain"}}},"children":[]}]}],"key":"SB7AAuZ5hD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Result of any arithmetic or similar operation involving NULL is NULL. So: 10 + NULL = NULL, 10 * NULL = NULL, and so on.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QJr9ikeBWX"}],"key":"tMjrDhyn9p"}],"key":"U62LCP5y0S"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%sql select i * 10 from R;","key":"ZzVpBxWTT3"},{"type":"outputs","id":"HT73AlR0hUOAyQTi9haAR","key":"J1EnERFajv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":" * postgresql://postgres:***@localhost/university\n6 rows affected.\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":6,"metadata":{},"data":{"text/html":{"content":"<table>\n    <thead>\n        <tr>\n            <th>?column?</th>\n        </tr>\n    </thead>\n    <tbody>\n        <tr>\n            <td>100</td>\n        </tr>\n        <tr>\n            <td>100</td>\n        </tr>\n        <tr>\n            <td>100</td>\n        </tr>\n        <tr>\n            <td>None</td>\n        </tr>\n        <tr>\n            <td>None</td>\n        </tr>\n        <tr>\n            <td>200</td>\n        </tr>\n    </tbody>\n</table>","content_type":"text/html"},"text/plain":{"content":"[(100,), (100,), (100,), (None,), (None,), (200,)]","content_type":"text/plain"}}},"children":[]}]}],"key":"L6UIBiOUYx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"On the other hand, the result of a boolean operation involving a NULL is an ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"opyGkWnYnM"},{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"UNKNOWN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cNIHPoXDht"}],"key":"eVaiHknfOM"},{"type":"text","value":", which is another special value used by SQL. So the result of: NULL = 10 is an UNKNOWN.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rFN7eIkqQh"}],"key":"FfzwSvDCDr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Consider a joint predicate: (NULL = 10) or (10 = 10). The first part evaluates to an UNKNOWN, whereas the second part evaluates to a TRUE. In this case, the joint predicate evaluates to a TRUE -- because whichever value UNKNOWN might take (TRUE or FALSE), the result of the joint predicate will always be TRUE.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zJa4RuGhtM"}],"key":"tlX8UoySvK"}],"key":"jCC0kVzCxt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Similarly: UNKNOWN OR FALSE = UNKNOWN, because the result depends on what is the actual value of the first part.\nUNKNOWN and TRUE = UNKNOWN.\nUNKNOWN and FALSE = FALSE.","position":{"start":{"lin