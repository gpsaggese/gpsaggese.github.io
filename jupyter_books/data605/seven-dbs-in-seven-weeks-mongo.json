vOK","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[{'_id': ObjectId('69b1c22b4234608da058e601'),\n  'famousFor': ['the MOMA', 'food', 'Derek Jeter'],\n  'lastCensus': '2022-11-01',\n  'mayor': {'name': 'Bill de Blasio', 'party': 'D'},\n  'name': 'New York',\n  'population': 22200000},\n {'_id': ObjectId('69b1c22b4234608da058e602'),\n  'famousFor': ['Punxsutawney Phil'],\n  'lastCensus': '2016-01-31',\n  'mayor': {'name': 'Richard Alexander'},\n  'name': 'Punxsutawney',\n  'population': 6200},\n {'_id': ObjectId('69b1c22b4234608da058e603'),\n  'famousFor': ['beer', 'food', 'Portlandia'],\n  'lastCensus': '2016-09-20',\n  'mayor': {'name': 'Ted Wheeler', 'party': 'D'},\n  'name': 'Portland',\n  'population': 582000}]\n"},"children":[]}]}],"key":"YiPhz7q1Fe"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:51:38.417960Z","start_time":"2024-02-29T00:51:38.409199Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Find the ID for a given document.\nobject_id_for_Portland = str(db.towns.find_one({\"name\": \"Portland\"})[\"_id\"])\nprint(\"object_id_for_Portland=\", object_id_for_Portland)\n\n# Note that types matter, so searching for an _id as string doesn't work.\n# print_(db.towns.find_one({\"_id\": object_id_for_Portland}))\nprint_(db.towns.find_one({\"_id\": ObjectId(object_id_for_Portland)}))","key":"ircQXMJb9j"},{"type":"outputs","id":"j4nGQxLfb_Bx2osR2nyx_","key":"zSVVtCv2IQ","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"object_id_for_Portland= 69b1c22b4234608da058e603\n{'_id': ObjectId('69b1c22b4234608da058e603'),\n 'famousFor': ['beer', 'food', 'Portlandia'],\n 'lastCensus': '2016-09-20',\n 'mayor': {'name': 'Ted Wheeler', 'party': 'D'},\n 'name': 'Portland',\n 'population': 582000}\n"},"children":[]}]}],"key":"mlJhtXlOMZ"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:52:07.508095Z","start_time":"2024-02-29T00:52:07.492978Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# There are multiple cities called Portland in US (e.g., in Oregon and in Maine).\n# So add the state.\ndb.towns.update_one(\n    {\"_id\": ObjectId(object_id_for_Portland)}, {\"$set\": {\"state\": \"OR\"}}\n)\n\nprint_(db.towns.find({\"_id\": ObjectId(object_id_for_Portland)}))\n\n# Note that we need to specify $set.\n# Mongo thinks in terms of documents and not attributes. So if you specify:\n# db.towns.update_one({\"_id\": ObjectId(\"63696c28657571ee34691de3\")},\n#                     {\"state\": \"OR\"})\n# the entire document will be replaced with the document `{\"state\": \"OR\"}`","key":"VD5rJj7amg"},{"type":"outputs","id":"Jd-FfxaLzy2QhS9T2_Xde","key":"GueosllypT","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[{'_id': ObjectId('69b1c22b4234608da058e603'),\n  'famousFor': ['beer', 'food', 'Portlandia'],\n  'lastCensus': '2016-09-20',\n  'mayor': {'name': 'Ted Wheeler', 'party': 'D'},\n  'name': 'Portland',\n  'population': 582000,\n  'state': 'OR'}]\n"},"children":[]}]}],"key":"eWj0SVM3kg"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:52:40.038374Z","start_time":"2024-02-29T00:52:40.030490Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Increment the population.\ndb.towns.update_one(\n    {\"_id\": ObjectId(object_id_for_Portland)}, {\"$inc\": {\"population\": 1000}}\n)\nprint_(db.towns.find({\"_id\": ObjectId(object_id_for_Portland)}))","key":"VrPPQRZhq6"},{"type":"outputs","id":"Wb1xxx_0C7KglsadyO7Pk","key":"NegBK0lRht","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[{'_id': ObjectId('69b1c22b4234608da058e603'),\n  'famousFor': ['beer', 'food', 'Portlandia'],\n  'lastCensus': '2016-09-20',\n  'mayor': {'name': 'Ted Wheeler', 'party': 'D'},\n  'name': 'Portland',\n  'population': 583000,\n  'state': 'OR'}]\n"},"children":[]}]}],"key":"AQCWpYAz1e"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":1,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"countries","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pi6D8yyNfR"},{"type":"text","value":" collection","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WuZ7Ll26Ho"}],"identifier":"countries-collection","label":"countries collection","html_id":"countries-collection","implicit":true,"key":"xa35x4xNZ1"}],"key":"ufrZnEvZCM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Insert","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"efqo0uW40E"}],"identifier":"insert","label":"Insert","html_id":"insert-1","implicit":true,"key":"JKAZVMeBVZ"}],"key":"QdU9CcV4yk"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:53:00.999274Z","start_time":"2024-02-29T00:53:00.974697Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Delete collection, if it exists.\ndb.countries.drop()\n\n# Note that:\n# 1) we define the _id directly\n# 2) the schema is not strict\ndb.countries.insert_one(\n    {\n        \"_id\": \"us\",\n        \"name\": \"United States\",\n        \"exports\": {\n            \"foods\": [{\"name\": \"bacon\", \"tasty\": True}, {\"name\": \"burgers\"}]\n        },\n    }\n)\n\ndb.countries.insert_one(\n    {\n        \"_id\": \"ca\",\n        \"name\": \"Canada\",\n        \"exports\": {\n            \"foods\": [\n                {\"name\": \"bacon\", \"tasty\": False},\n                {\"name\": \"syrup\", \"tasty\": True},\n            ]\n        },\n    }\n)\n\ndb.countries.insert_one(\n    {\n        \"_id\": \"mx\",\n        \"name\": \"Mexico\",\n        \"exports\": {\n            \"foods\": [{\"name\": \"salsa\", \"tasty\": True, \"condiment\": True}]\n        },\n    }\n)\n\nassert db.countries.count_documents({}) == 3","key":"nXtsjj4UsS"},{"type":"outputs","id":"uRU8v2EEcTc_COV_tqgL0","key":"WoWcKNwGdR","children":[]}],"key":"DbWXhJiTZS"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:53:06.147926Z","start_time":"2024-02-29T00:53:06.141359Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"for obj in db[\"countries\"].find():\n    print_(obj)","key":"yboBJZWmzA"},{"type":"outputs","id":"T3LFXieKaPQ1iAcDjZ7uU","key":"eIKmpYfDyu","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"{'_id': 'us',\n 'exports': {'foods': [{'name': 'bacon', 'tasty': True}, {'name': 'burgers'}]},\n 'name': 'United States'}\n{'_id': 'ca',\n 'exports': {'foods': [{'name': 'bacon', 'tasty': False},\n                       {'name': 'syrup', 'tasty': True}]},\n 'name': 'Canada'}\n{'_id': 'mx',\n 'exports': {'foods': [{'condiment': True, 'name': 'salsa', 'tasty': True}]},\n 'name': 'Mexico'}\n"},"children":[]}]}],"key":"hSB15iqwZ3"},{"type":"block","kind":"notebook-content","data":{"ExecuteTime":{"end_time":"2022-12-11T20:04:52.749811Z","start_time":"2022-12-11T20:04:52.745417Z"}},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Query","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gVbK2mVf6Z"}],"identifier":"query","label":"Query","html_id":"query-1","implicit":true,"key":"uwoMOVYgKO"}],"key":"rHnhurAdXV"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:54:17.932345Z","start_time":"2024-02-29T00:54:17.919126Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Find the country that exports tasty bacon.\n\n# This doesn't return what we want, since we want the AND of the condition and not OR.\nprint_(\n    db.countries.find(\n        {\n            \"exports.foods.name\": \"bacon\",\n            \"exports.foods.tasty\": True,\n        },\n        {\"_id\": 0, \"name\": 1},\n    )\n)","key":"cSGv265Nlq"},{"type":"outputs","id":"Uh7k-VFGKNLtI-bTA9tyj","key":"n76lKn2j6L","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[{'name': 'United States'}, {'name': 'Canada'}]\n"},"children":[]}]}],"key":"uLmAvM5JyX"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-29T00:54:41.837773Z","start_time":"2024-02-29T00:54:41.830767Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# Using $elemMatch.\nprint_(\n    db.countries.find(\n        {\n            \"exports.foods\": {\n                \"$elemMatch\": {\n                    \"name\": \"bacon\",\n                    \"tasty\": True,\n                }\n            }\n        },\n        {\"_id\": 0, \"name\": 1},\n    )\n)","key":"Xy0qBBMMUE"},{"type":"outputs","id":"QPENm5oFG8MHcDGsW0nTj","key":"NFAG7xj2ho","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[{'name': 'United States'}]\n"},"children":[]}]}],"key":"vU1kOJLnWl"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2024-02-28T21:51:46.782973Z","start_time":"2024-02-28T21:51:46.778314Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# This performs an AND.\nprint_(db.countries.find({\"_id\": \"mx\", \"name\": \"United States\"}))\n\n# This performs an OR.\nprint_(\n    db.countries.find(\n        {\"$or\": [{\"_id\": \"mx\"}, {\"name\": \"United States\"}]}, {\"_id\": 1}\n    )\n)","key":"HWRLD2W5WO"},{"type":"outputs","id":"rhdd7AOoZANJYsr89N-sC","key":"a0yQm6o68o","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[]\n[{'_id': 'us'}, {