{"version":3,"kind":"Notebook","sha256":"a26027be65ec759935eb84c3bde190b5c5cbae597750c8ae96018f58613614f2","slug":"learning-spark-2e-chap3","location":"/../tutorials/tutorial_spark/Learning_Spark_2e.Chap3.ipynb","dependencies":[],"frontmatter":{"kernelspec":{"name":"python3","display_name":"Python 3 (ipykernel)","language":"python"},"jupytext":{"formats":"ipynb,py:percent"},"numbering":{"title":{"offset":1}},"exports":[{"format":"ipynb","filename":"Learning_Spark_2e.Chap3.ipynb","url":"/jupyter_books/data605/build/Learning_Spark_2e.Ch-cb0cd0d03eb73f0327596d0c398bed1a.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2022-11-20T15:35:07.658200Z","start_time":"2022-11-20T15:35:07.618569Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"# In Python\n# Create an RDD of tuples (name, age)\ndataRDD = sc.parallelize(\n    [(\"Brooke\", 20), (\"Denny\", 31), (\"Jules\", 30), (\"TD\", 35), (\"Brooke\", 25)]\n)\nprint(dataRDD)\n# Use map and reduceByKey transformations with their lambda\n# expressions to aggregate and then compute average\nagesRDD = (\n    dataRDD.map(lambda x: (x[0], (x[1], 1)))\n    .reduceByKey(lambda x, y: (x[0] + y[0], x[1] + y[1]))\n    .map(lambda x: (x[0], x[1][0] / x[1][1]))\n)","key":"aIj2m1rvwo"},{"type":"outputs","id":"W8Q5SQzLtvmXHrWItpJkj","key":"IKAGnNwnse","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"ParallelCollectionRDD[10] at readRDDFromFile at PythonRDD.scala:274\n"},"children":[]}]}],"key":"NbOsCPxV6l"},{"type":"block","kind":"notebook-code","data":{"ExecuteTime":{"end_time":"2022-11-20T15:35:33.195900Z","start_time":"2022-11-20T15:35:29.841181Z"}},"children":[{"type":"code","lang":"python","executable":true,"value":"from pyspark.sql import SparkSession\nfrom pyspark.sql.functions import avg\n\n# Create a DataFrame using SparkSession\nspark = SparkSession.builder.appName(\"AuthorsAges\").getOrCreate()\n# Create a DataFrame\ndata_df = spark.createDataFrame(\n    [(\"Brooke\", 20), (\"Denny\", 31), (\"Jules\", 30), (\"TD\", 35), (\"Brooke\", 25)],\n    [\"name\", \"age\"],\n)\n# Group the same names together, aggregate their ages, and compute an average\navg_df = data_df.groupBy(\"name\").agg(avg(\"age\"))\n# Show the results of the final execution\navg_df.show()","key":"PQwRK6nTJM"},{"type":"outputs","id":"UbOIF5E8a8vqygb7uBwJh","key":"U2yXka2StM","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"\r[Stage 3:=============================>                             (3 + 3) / 6]\r"},"children":[]},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"+------+--------+\n|  name|avg(age)|\n+------+--------+\n|Brooke|    22.5|\n| Denny|    31.0|\n| Jules|    30.0|\n|    TD|    35.0|\n+------+--------+\n\n"},"children":[]},{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"\r                                                                                \r"},"children":[]}]}],"key":"zaP4fde35y"}],"key":"Usg76zszui"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Learning Spark 2e. Chap2","url":"/learning-spark-2e-chap2","group":"University DB"},"next":{"title":"Spark   Assignment","url":"/spark-assignment","group":"University DB"}}},"domain":"http://localhost:3000"}