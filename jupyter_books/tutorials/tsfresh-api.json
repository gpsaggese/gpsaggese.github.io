"key":"xhVoCi0rf7"}],"key":"dpWmst62zV"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from sklearn.ensemble import RandomForestClassifier\nfrom sklearn.pipeline import Pipeline\nfrom tsfresh.transformers import RelevantFeatureAugmenter\n\n# Build pipeline: feature augmentation → classifier.\npipeline = Pipeline(\n    [\n        (\n            \"augmenter\",\n            RelevantFeatureAugmenter(\n                column_id=\"id\",\n                column_sort=\"time\",\n                column_value=\"value\",\n                default_fc_parameters=fe.MinimalFCParameters(),\n                disable_progressbar=True,\n            ),\n        ),\n        (\"classifier\", RandomForestClassifier(n_estimators=10, random_state=0)),\n    ]\n)\n\n# For the pipeline we need a DataFrame indexed by id.\n# The augmenter works on the *original* long-format data set via timeseries_container.\npipeline.set_params(augmenter__timeseries_container=df_uni)\npipeline.fit(pd.DataFrame(index=y.index), y)\nprint(\"Pipeline trained successfully.\")\nprint(\"Predicted:\", pipeline.predict(pd.DataFrame(index=y.index)))","key":"OcoRAiJA66"},{"type":"outputs","id":"z7MCR6NWYFdOXNma3xCv1","key":"ZL4vgc8n1L","children":[]}],"key":"XHvf83ZXJi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Custom Feature Calculators","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WZ5wh7Bg1C"}],"identifier":"custom-feature-calculators","label":"Custom Feature Calculators","html_id":"custom-feature-calculators","implicit":true,"key":"CuamaY1ygO"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"You can register your own feature function by decorating it with\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xFCKLDIsaa"},{"type":"inlineCode","value":"@set_property(\"fctype\", \"simple\")","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dcZnjmY8rv"},{"type":"text","value":" and including it in a\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qFkXQTaUEG"},{"type":"inlineCode","value":"CustomFCParameters","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R56oQEsXpS"},{"type":"text","value":" dict.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"X5pmg3g0Fn"}],"key":"YDl4KZKDGh"}],"key":"YZDHfxAxAO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from tsfresh.feature_extraction.feature_calculators import set_property\n\n\n@set_property(\"fctype\", \"simple\")\ndef range_value(x):\n    \"\"\"Return max - min of the time series.\"\"\"\n    return float(np.max(x) - np.min(x))\n\n\ncustom_settings = {\"range_value\": None}\nX_custom = extract_features(\n    df_uni,\n    column_id=\"id\",\n    column_sort=\"time\",\n    column_value=\"value\",\n    default_fc_parameters=custom_settings,\n    disable_progressbar=True,\n)\nprint(\"Custom feature (range_value):\")\nprint(X_custom)","key":"WZqfwAuJJY"},{"type":"outputs","id":"Q-sKuaEIr1udtNLuamygk","key":"XuRKklvTgb","children":[]}],"key":"zoRnLcWhoo"}],"key":"QG15gdtpia"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"tsfresh Tutorial","url":"/readme-25","group":"data science packages"},"next":{"title":"tsfresh: Human Activity Recognition","url":"/tsfresh-example","group":"data science packages"}}},"domain":"http://localhost:3000"}