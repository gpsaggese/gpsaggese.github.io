"key":"vIo6nSZ9y1"}],"key":"rw8VHKzezZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from sklearn.ensemble import RandomForestClassifier\nfrom sklearn.pipeline import Pipeline\nfrom tsfresh.transformers import RelevantFeatureAugmenter\n\n# Build pipeline: feature augmentation → classifier.\npipeline = Pipeline(\n    [\n        (\n            \"augmenter\",\n            RelevantFeatureAugmenter(\n                column_id=\"id\",\n                column_sort=\"time\",\n                column_value=\"value\",\n                default_fc_parameters=fe.MinimalFCParameters(),\n                disable_progressbar=True,\n            ),\n        ),\n        (\"classifier\", RandomForestClassifier(n_estimators=10, random_state=0)),\n    ]\n)\n\n# For the pipeline we need a DataFrame indexed by id.\n# The augmenter works on the *original* long-format data set via timeseries_container.\npipeline.set_params(augmenter__timeseries_container=df_uni)\npipeline.fit(pd.DataFrame(index=y.index), y)\nprint(\"Pipeline trained successfully.\")\nprint(\"Predicted:\", pipeline.predict(pd.DataFrame(index=y.index)))","key":"fM31UqwhRt"},{"type":"outputs","id":"pwwCjbLDvNhnv_BJKhv6r","key":"QfZlJIKBlQ","children":[]}],"key":"No3iJnU8bi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Custom Feature Calculators","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sSHnMq6cDP"}],"identifier":"custom-feature-calculators","label":"Custom Feature Calculators","html_id":"custom-feature-calculators","implicit":true,"key":"EroebTjA8K"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"You can register your own feature function by decorating it with\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dLRAoAwfln"},{"type":"inlineCode","value":"@set_property(\"fctype\", \"simple\")","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AaXLJj096h"},{"type":"text","value":" and including it in a\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hX3yppe4ih"},{"type":"inlineCode","value":"CustomFCParameters","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qv2rSihXlA"},{"type":"text","value":" dict.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kCv60zwwCi"}],"key":"DJyZ7Wbcuk"}],"key":"nLIOKjXWAK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from tsfresh.feature_extraction.feature_calculators import set_property\n\n\n@set_property(\"fctype\", \"simple\")\ndef range_value(x):\n    \"\"\"Return max - min of the time series.\"\"\"\n    return float(np.max(x) - np.min(x))\n\n\ncustom_settings = {\"range_value\": None}\nX_custom = extract_features(\n    df_uni,\n    column_id=\"id\",\n    column_sort=\"time\",\n    column_value=\"value\",\n    default_fc_parameters=custom_settings,\n    disable_progressbar=True,\n)\nprint(\"Custom feature (range_value):\")\nprint(X_custom)","key":"SlXu4HgFJt"},{"type":"outputs","id":"vyxP5_5800OfQU9XNSlg0","key":"IY3PP3GTeW","children":[]}],"key":"ontht68PIQ"}],"key":"sprU2dbXRv"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"tsfresh Tutorial","url":"/readme-25","group":"data science packages"},"next":{"title":"tsfresh: Human Activity Recognition","url":"/tsfresh-example","group":"data science packages"}}},"domain":"http://localhost:3000"}