column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 1: Generate Economic Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rviizN6xhL"}],"identifier":"part-1-generate-economic-data","label":"Part 1: Generate Economic Data","html_id":"part-1-generate-economic-data","implicit":true,"key":"OoDtfnWGwb"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"We’ll simulate a realistic economic system where variables have\ncausal relationships, then discover these relationships.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"gxR6gSzUVR"}],"key":"T4dlOVbZaG"}],"key":"Mn0mvO2z6Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Generate synthetic economic data.\n# Variables: GDP, Inflation, Unemployment, Interest_Rate, Stock_Market\nn_nodes = 5\nn_samples = 1000\nnode_names = [\n    \"GDP\",\n    \"Inflation\",\n    \"Unemployment\",\n    \"Interest_Rate\",\n    \"Stock_Market\",\n]\n\nprint(\n    f\"Generating {n_nodes}-variable economic system with {n_samples} observations...\"\n)\n\ndata, true_dag = tgcasti.generate_synthetic_data(\n    n_nodes=n_nodes,\n    n_edges=6,\n    n_samples=n_samples,\n    seed=123,\n)\n\n# Rename columns to meaningful names.\ndata.columns = node_names\n\nprint(f\"\\nGenerated data shape: {data.shape}\")\nprint(\"\\nData summary statistics:\")\nprint(data.describe())","key":"eLCwR8yIYT"},{"type":"outputs","id":"38-UDlDQEgazStNTQ1wLd","key":"Lg7yeO6Hhz","children":[]}],"key":"R5PcqQHiJ7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 2: Visualize the True Causal Structure","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MfAHEniQfV"}],"identifier":"part-2-visualize-the-true-causal-structure","label":"Part 2: Visualize the True Causal Structure","html_id":"part-2-visualize-the-true-causal-structure","implicit":true,"key":"fGm23s37G6"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Before running discovery algorithms, let’s see what the ground truth DAG looks like.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ygOlKVJbAT"}],"key":"iuiQDjaiIg"}],"key":"gW5vE3u8l9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Visualize true causal relationships.\nfig = tgcasti.visualize_dag(\n    true_dag.to_numpy(),\n    title=\"True Economic Causal Structure\",\n    node_labels=node_names,\n    figsize=(10, 8),\n)\nprint(\"This is the true causal structure we're trying to discover.\")","key":"SwaNVLIOnD"},{"type":"outputs","id":"RtIUSj6qH69rdwyFAETZT","key":"dIQOSKLYcO","children":[]}],"key":"g4E4qxuyqB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 3: Run Multiple Discovery Algorithms","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HoUZUuydtx"}],"identifier":"part-3-run-multiple-discovery-algorithms","label":"Part 3: Run Multiple Discovery Algorithms","html_id":"part-3-run-multiple-discovery-algorithms","implicit":true,"key":"qOlVCXsbfb"}],"key":"rfD9B7lIzU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Constraint-Based Approach (PC)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"GZ9Ih9fC7b"}],"identifier":"constraint-based-approach-pc","label":"Constraint-Based Approach (PC)","html_id":"constraint-based-approach-pc","implicit":true,"key":"Ccsh7zTKKm"}],"key":"GwbhbDW5ak"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# The PC algorithm uses statistical independence tests.\n# It's robust but requires sufficient data.\n\n_LOG.info(\"Running PC algorithm...\")\npc_result = tgcasti.run_pc_algorithm(\n    data.values,\n    alpha=0.05,\n)\n\npc_metrics = tgcasti.evaluate_causal_discovery(\n    true_dag.to_numpy(),\n    pc_result,\n)\n\nprint(\"PC Algorithm Results:\")\nprint(f\"  F1 Score: {pc_metrics['F1']:.4f}\")\nprint(f\"  Structural Hamming Distance: {pc_metrics['SHD']:.1f}\")\nprint(f\"  False Discovery Rate: {pc_metrics['FDR']:.4f}\")\nprint(f\"  True Positive Rate: {pc_metrics['TPR']:.4f}\")","key":"UAz878ccAc"},{"type":"outputs","id":"ZbdkEuFu0_xOQ2Kdm8G9X","key":"PpXoHkJvZv","children":[]}],"key":"SvylWiy1kd"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Score-Based Approach (GES)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EdPHRW1wK6"}],"identifier":"score-based-approach-ges","label":"Score-Based Approach (GES)","html_id":"score-based-approach-ges","implicit":true,"key":"ijnWVdC2IX"}],"key":"Ip0khwud1g"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# GES optimizes a Bayesian score function.\n# It's efficient and works well with moderate-sized datasets.\n\n_LOG.info(\"Running GES algorithm...\")\nges_result = tgcasti.run_ges_algorithm(data.values)\n\nges_metrics = tgcasti.evaluate_causal_discovery(\n    true_dag.to_numpy(),\n    ges_result,\n)\n\nprint(\"GES Algorithm Results:\")\nprint(f\"  F1 Score: {ges_metrics['F1']:.4f}\")\nprint(f\"  Structural Hamming Distance: {ges_metrics['SHD']:.1f}\")\nprint(f\"  False Discovery Rate: {ges_metrics['FDR']:.4f}\")\nprint(f\"  True Positive Rate: {ges_metrics['TPR']:.4f}\")","key":"hNfV0gzN2L"},{"type":"outputs","id":"lLu4NpoX3vTB5y9Gahxh5","key":"Neh0zGjAn6","children":[]}],"key":"sI2N5XQZnW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Gradient-Based Approach (NOTEARS)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iklbWf27Ft"}],"identifier":"gradient-based-approach-notears","label":"Gradient-Based Approach (NOTEARS)","html_id":"gradient-based-approach-notears","implicit":true,"key":"v8VKfPKCy6"}],"key":"THqVh17dNI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# NOTEARS uses continuous optimization with acyclicity constraints.\n# It's scalable and handles large datasets efficiently.\n\n_LOG.info(\"Running NOTEARS algorithm...\")\nnotears_result = tgcasti.run_notears_algorithm(\n    data.values,\n    lambda1=0.01,\n    loss_type=\"l2\",\n)\n\nnotears_metrics = tgcasti.evaluate_causal_discovery(\n    true_dag.to_numpy(),\n    notears_result,\n)\n\nprint(\"NOTEARS Algorithm Results:\")\nprint(f\"  F1 Score: {notears_metrics['F1']:.4f}\")\nprint(f\"  Structural Hamming Distance: {notears_metrics['SHD']:.1f}\")\nprint(f\"  False Discovery Rate: {notears_metrics['FDR']:.4f}\")\nprint(f\"  True Positive Rate: {notears_metrics['TPR']:.4f}\")","key":"b9wso5m4u2"},{"type":"outputs","id":"SSzwuS8yYuycbE6k8WqrY","key":"VNiITDDXNg","children":[]}],"key":"K6IZHpT8WI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 4: Thresholding Weighted Results","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jau8VOzol3"}],"identifier":"part-4-thresholding-weighted-results","label":"Part 4: Thresholding Weighted Results","html_id":"part-4-thresholding-weighted-results","implicit":true,"key":"TWw5Uf70R2"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Some algorithms return weighted edges. Apply a threshold to binarize them.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GgKg6st2IU"}],"key":"DkHaktbZ72"}],"key":"y2bzE3py5R"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Threshold the NOTEARS result (remove weak edges).\nnotears_binary = tgcasti.thresholded_dag(\n    notears_result,\n    threshold=0.2,\n)\n\nnotears_binary_metrics = tgcasti.evaluate_causal_discovery(\n    true_dag.to_numpy(),\n    notears_binary,\n)\n\nprint(\"NOTEARS (thresholded at 0.2):\")\nprint(f\"  F1 Score: {notears_binary_metrics['F1']:.4f}\")\nprint(f\"  Structural Hamming Distance: {notears_binary_metrics['SHD']:.1f}\")","key":"c39uwrLh6V"},{"type":"outputs","id":"qIohy64PQlffAARQ4E6kt","key":"akkw7Svbzp","children":[]}],"key":"gk0waTaTIY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 5: Comprehensive Comparison","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FAUEsOPcBc"}],"identifier":"part-5-comprehensive-comparison","label":"Part 5: Comprehensive Comparison","html_id":"part-5-comprehensive-comparison","implicit":true,"key":"mEZFtKSfIY"}],"key":"pj5DOiyV61"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Compare all discovered structures side-by-side.\nalgorithms_results = {\n    \"PC\": pc_result,\n    \"GES\": ges_result,\n    \"NOTEARS\": notears_result,\n}\n\nfig = tgcasti.compare_dags(\n    true_dag.to_numpy(),\n    algorithms_results,\n    node_labels=node_names,\n)\nfig.suptitle(\n    \"Causal Discovery Results: Economic Indicators\",\n    fontsize=14,\n    fontweight=\"bold\",\n)","key":"fsdXxWlhvv"},{"type":"outputs","id":"8rFFUmEJFF4ZmEl0eipDd","key":"JRjusGam7N","children":[]}],"key":"FUhnFMmAFj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 6: Performance Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XfEckVwesR"}],"identifier":"part-6-performance-summary","label":"Part 6: Performance Summary","html_id":"part-6-performance-summary","implicit":true,"key":"WbB7YkzWs0"}],"key":"yk7WtV7hza"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create a comprehensive performance comparison.\ncomparison_data = {\n    \"Algorithm\": [\"PC\", \"GES\", \"NOTEARS\", \"NOTEARS*\"],\n    \"F1\": [\n        pc_metrics[\"F1\"],\n        ges_metrics[\"F1\"],\n        notears_metrics[\"F1\"],\n        notears_binary_metrics[\"F1\"],\n    ],\n    \"SHD\": [\n        pc_metrics[\"SHD\"],\n        ges_metrics[\"SHD\"],\n        notears_metrics[\"SHD\"],\n        notears_binary_metrics[\"SHD\"],\n    ],\n    \"TPR\": [\n        pc_metrics[\"TPR\"],\n        ges_metrics[\"TPR\"],\n        notears_metrics[\"TPR\"],\n        notears_binary_metrics[\"TPR\"],\n    ],\n    \"FDR\": [\n        pc_metrics[\"FDR\"],\n        ges_metrics[\"FDR\"],\n        notears_metrics[\"FDR\"],\n        notears_binary_metrics[\"FDR\"],\n    ],\n}\n\ncomparison_df = pd.DataFrame(comparison_data)\nprint(\"\\nPerformance Comparison Table\")\nprint(\"(* = NOTEARS with thresholding)\")\nprint(comparison_df.to_string(index=False))","key":"c91jK6D7w6"},{"type":"outputs","id":"1c-YFoOk-y6EPqQBvNnbP","key":"rxwFMX15vU","children":[]}],"key":"wLel6HIBLb"},{"type":"block","kind":"notebook-content","children":[{"type":"hea