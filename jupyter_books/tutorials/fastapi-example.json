:1},"end":{"line":12,"column":1}},"key":"YQGZi3f1OE"},{"type":"text","value":", which is faster for exploration but skips the network entirely.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"JO5qXnoHEr"}],"key":"OV4jgWnbin"}],"key":"EthJll0rmS"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Must run top to bottom after a kernel restart.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"wZswlrxYB5"}],"key":"w7DRvonwsn"}],"key":"rxFkY4v3Li"}],"key":"mHXsCiAyJi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"!pip install --quiet -r tutorial_requirements.txt","key":"UMPEx6Twqg"},{"type":"outputs","id":"rXqJpzvGjiseuS4vKZv99","key":"Ygms17CUz6","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\n\u001b[0m"},"children":[]}]}],"key":"f1SP111558"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%load_ext autoreload\n%autoreload 2\n\nimport logging\n\nimport httpx\n\nimport fastapi_utils\nimport helpers.hdbg as hdbg\nimport helpers.hintrospection as hintros\n\nhdbg.init_logger(verbosity=logging.INFO)\n_LOG = logging.getLogger(__name__)\n\nPORT = 8010\nBASE_URL = f\"http://127.0.0.1:{PORT}\"","key":"TA4woyjIxA"},{"type":"outputs","id":"3loXMy1cOBhsvov1jiC6O","key":"NkKxhs0hxa","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The autoreload extension is already loaded. To reload it, use:\n  %reload_ext autoreload\n\u001b[0m\u001b[33mWARNING\u001b[0m: Logger already initialized: skipping\n"},"children":[]}]}],"key":"sPMqsASPkG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 1: Build the App","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"x7algNsxx6"}],"identifier":"part-1-build-the-app","label":"Part 1: Build the App","html_id":"part-1-build-the-app","implicit":true,"key":"fHQYrgxTwm"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"create_book_app()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"a1YcHksFBp"},{"type":"text","value":" wires up the routes and seeds an in-memory catalog.\nListing ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"f1TOMQ9Laa"},{"type":"inlineCode","value":"app.routes","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ym2jQ4rUqP"},{"type":"text","value":" shows exactly what got registered, which is a useful\nsanity check before starting the server.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aFCTFZzTnf"}],"key":"ji9VVCGriu"}],"key":"NIoc3VQu2o"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"hintros.print_obj_info(fastapi_utils.create_book_app)","key":"u7gXyVnzvb"},{"type":"outputs","id":"KYalaM27szbi_YKxUnqK6","key":"Z8GFjdczhC","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/markdown":{"content":"**function**","content_type":"text/markdown"},"text/plain":{"content":"<IPython.core.display.Markdown object>","content_type":"text/plain"}}},"children":[]},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"https://github.com/gpsaggese/gpsaggese.github.io/blob/gp_scratch/tutorials/fastapi/fastapi_utils.py#L94\n"},"children":[]}]}],"key":"K7JssySspF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Build the app: wires up the routes and seeds the in-memory catalog.\napp = fastapi_utils.create_book_app()\n\nfor route in app.routes:\n    methods = \",\".join(sorted(getattr(route, \"methods\", []) or []))\n    _LOG.info(\"%-6s %s\", methods, getattr(route, \"path\", route))\n# Outcome: `app` is a ready-to-serve `FastAPI` instance; the log lists every\n# registered route, including the built-in `/docs`, `/redoc`, and\n# `/openapi.json`, plus the catalog's `/health` and `/books` routes.","key":"L093JuHGbL"},{"type":"outputs","id":"HrzUpjfVQYxc2VjJRL6UI","key":"bqmKnaGwC5","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"INFO  GET,HEAD /openapi.json\nINFO  GET,HEAD /docs\nINFO  GET,HEAD /docs/oauth2-redirect\nINFO  GET,HEAD /redoc\nINFO  GET    /health\nINFO  GET    /books\nINFO  GET    /books/{book_id}\nINFO  POST   /books\nINFO  PATCH  /books/{book_id}\nINFO  DELETE /books/{book_id}\n"},"children":[]}]}],"key":"dkTgRyDDkM"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 2: Start the Server","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SKSefFAQi7"}],"identifier":"part-2-start-the-server","label":"Part 2: Start the Server","html_id":"part-2-start-the-server","implicit":true,"key":"IwsakwZ2fi"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"run_server_in_background()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jKycBOOfpV"},{"type":"text","value":" starts ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tqNkLHADmK"},{"type":"inlineCode","value":"uvicorn","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"b4hx8zXvAQ"},{"type":"text","value":" on a daemon thread.\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MVc0Hk3iId"},{"type":"inlineCode","value":"wait_for_server()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hJvYmso6KI"},{"type":"text","value":" polls ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FFkIP0u3So"},{"type":"inlineCode","value":"/health","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CIH0gKemk4"},{"type":"text","value":" until the socket accepts connections,\nso the next cell never races the server startup.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ogmTslxwW5"}],"key":"oQGZDFQGbl"}],"key":"y6QL5KEEsX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Start `uvicorn` on a daemon thread, then block until `/health` responds.\nserver, server_thread = fastapi_utils.run_server_in_background(app, port=PORT)\nfastapi_utils.wait_for_server(f\"{BASE_URL}/health\")\n_LOG.info(\"Server is up at %s\", BASE_URL)\n# Outcome: the server is accepting real TCP connections at `BASE_URL`.","key":"w89UKz6DfG"},{"type":"outputs","id":"REHG5t85ZZlEDZ-KWaaOF","key":"sieA1LtwPR","children":[]}],"key":"MbYpkHbNE5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 3: List and Filter Books","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OlDsgGLebb"}],"identifier":"part-3-list-and-filter-books","label":"Part 3: List and Filter Books","html_id":"part-3-list-and-filter-books","implicit":true,"key":"YKoCRcjNe0"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"These are real HTTP requests: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SEVyKYCD7x"},{"type":"inlineCode","value":"httpx","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mpa4hyto7u"},{"type":"text","value":" opens a TCP connection to\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EaunENPDqp"},{"type":"inlineCode","value":"127.0.0.1:8010","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bDaB4sZQYj"},{"type":"text","value":" instead of calling the app object directly.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TOBCDHXkDr"}],"key":"ifwki3TpH2"}],"key":"j3reot0Gwx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# List every book in the catalog.\nresponse = httpx.get(f\"{BASE_URL}/books\")\nresponse.raise_for_status()\n_LOG.info(\"All books: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: all 3 seeded books, in insertion order.\n\n# Filter to only out-of-stock books via the `in_stock` query parameter.\nresponse = httpx.get(f\"{BASE_URL}/books\", params={\"in_stock\": False})\n_LOG.info(\"Out-of-stock books: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: just \"Designing Data-Intensive Applications\", the only seed book\n# marked out of stock.\n\n# Cap the result to one book via the `limit` query parameter.\nresponse = httpx.get(f\"{BASE_URL}/books\", params={\"limit\": 1})\n_LOG.info(\"First book only: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: only \"Fluent Python\", the first seeded book.","key":"H8W0skml1o"},{"type":"outputs","id":"d8YGqQrgmFKhmpsXaf6-u","key":"EMaGWMRJme","children":[]}],"key":"OBlmCMYihc"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 4: Create, Update, and Delete a Book","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NS0iOSS9cy"}],"identifier":"part-4-create-update-and-delete-a-book","label":"Part 4: Create, Update, and Delete a Book","html_id":"part-4-create-update-and-delete-a-book","implicit":true,"key":"P8THeXhP82"}],"key":"cp9dhkG8Gg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create a new book; the server assigns the `id`.\nresponse = httpx.post(\n    f\"{BASE_URL}/books\",\n    json={\"title\": \"The Pragmatic Programmer\", \"author\": \"Hunt & Thomas\", \"year\": 1999},\n)\nresponse.raise_for_status()\nnew_book = response.json()\n_LOG.info(\"Created book %s: %s\", new_book[\"id\"], new_book[\"title\"])\n# Outcome: 201 Created; `new_book[\"id\"]` is 4, the next free ID after the\n# 3 seeded books.","key":"plpb8mvCcC"},{"type":"outputs","id":"XVZivIP7ed_oyBdCtLtsV","key":"Ppxdwh0sgU","children":[]}],"key":"m2aprzpCdE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Replace the new book's fields, flipping it to out of stock.\nresponse = httpx.patch(\n    f\"{BASE_URL}/books/{new_book['id']}\",\n    json={\n        \"title\": new_book[\"title\"],\n        \"author\": new_book[\"author\"],\n        \"year\": new_book[\"year\"],\n        \"in_stock\": False,\n    },\n)\nresponse.raise_for_status()\n_LOG.info(\"Updated book: %s\", response.json())\n# Outcome: 200 OK; the same book is returned with `in_stock` now `False`.","key":"KnUChYXMlN"},{"type":"outputs","id":"0L8ASc6Q9ilHVl37mwjV8","key":"RjgLsqM4KB","children":[]}],"key":"yLebU4ckBJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Delete the book that was just created and updated.\nresponse = httpx.delete(f\"{BASE_URL}/books/{new_book['id']}\")\n_LOG.info(\"DELETE status: %s\", response.status_code)\n# Outcome: 204 No Content; the book is removed from the catalog.\n\n# Confirm the deletion: the same ID should no longer resolve.\nresponse = httpx.get(f\"{BASE_URL}/books/{new_book['id']}\")\n_LOG.info(\"GET after delete: %s\", response.status_code)\n# Outcome: 404 Not Found.","key":"vh6Bb9jMLe"},{"type":"outputs","id":"X1J7RNbsD8EfaxJpCRfWv","key":"ffk8unE211","children":[]}],"key":"keUc1USj45"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 5: Handle Errors","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lxkmKWaULB"}],"identifier":"part-5-handle-errors","label":"Part 5: Handle Errors","html_id":"part-5-handle-errors","implicit":true,"key":"a7lVRH6Fbc"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"A missing book returns ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PzxoHNOfk4"},{"type":"inlineCode","value":"404","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Iby9CNESUG"},{"type":"text","value":"; an invalid payload never reaches the handler\nand returns ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"np6jKDQ3Bx"},{"type":"inlineCode","value":"422","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DpHd8VXtia"},{"type":"text","value":" with a description of what failed.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OdQTxARNOT"}],"key":"QGF6KRs6mt"}],"key":"SpXi3Eds0V"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Look up a book ID that was never created.\nresponse = httpx.get(f\"{BASE_URL}/books/99999\")\n_LOG.info(\"GET missing book -> %s %s\", response.status_code, response.json())\n# Outcome: 404 Not Found with {\"detail\": \"Book 99999 not found\"}.\n\n# Send a payload missing the required `author` and `year` fields.\nresponse = httpx.post(f\"{BASE_URL}/books\", json={\"title\": \"No Author or Year\"})\n_LOG.info(\"POST invalid payload -> %s\", response.status_code)\nfor error in response.json()[\"detail\"]:\n    _LOG.info(\"  %s: %s\", error[\"loc\"], error[\"msg\"])\n# Outcome: 422 Unprocessable Entity; the handler never runs, and the\n# response lists both missing fields.","key":"rxZY7Ezbn2"},{"type":"outputs","id":"Y_5xPM9VWIXbWnHhkk2ij","key":"waoPiNwwfl","children":[]}],"key":"SqDVUfL06s"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 6: Inspect the Live Docs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cPykV1OL4c"}],"identifier":"part-6-inspect-the-live-docs","label":"Part 6: Inspect the Live Docs","html_id":"part-6-inspect-the-live-docs","implicit":true,"key":"NB4YbUjGpA"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"With the server running, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eTTkOiqr0g"},{"type":"inlineCode","value":"/openapi.json","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BycGD7kZ6U"},{"type":"text","value":" is reachable over HTTP, and so are\nthe human-facing ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Z8iDOBw7H5"},{"type":"inlineCode","value":"/docs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ovTSnTucHD"},{"type":"text","value":" (Swagger UI) and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nN3uTKsrYz"},{"type":"inlineCode","value":"/redoc","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"O516GpuhJT"},{"type":"text","value":" pages. Point a browser at\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Rv4Rfukv5m"},{"type":"inlineCode","value":"http://127.0.0.1:8010/docs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ajKAM8Xcwv"},{"type":"text","value":" while this notebook’s server is up to try it\ninteractively.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UxcjhKkkg1"}],"key":"GV5ln5Ipt5"}],"key":"a76FQVwvld"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Fetch the OpenAPI schema `FastAPI` generated automatically.\nresponse = httpx.get(f\"{BASE_URL}/openapi.json\")\nschema = response.json()\n_LOG.info(\"OpenAPI title: %s\", schema[\"info\"][\"title\"])\n_LOG.info(\"Registered paths: %s\", sorted(schema[\"paths\"].keys()))\n# Outcome: title \"Book Catalog API\"; paths are /books, /books/{book_id},\n# and /health.","key":"DXFcr5b9nA"},{"type":"outputs","id":"9XAtG9VJTQcTcNqIZX4vU","key":"U5Kbh03n1E","children":[]}],"key":"CB5eadaSfu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 7: Shut Down the Server","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FoPYKgrgE4"}],"identifier":"part-7-shut-down-the-server","label":"Part 7: Shut Down the Server","html_id":"part-7-shut-down-the-server","implicit":true,"key":"K6dG7CaAze"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Always stop the background server before the kernel exits, so the port is\nfreed for the next run.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JxyJhQfJJn"}],"key":"v8TUgO7l4O"}],"key":"rV5LaRKvsa"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Stop the background `uvicorn` server and join its thread.\nfastapi_utils.stop_server(server, server_thread)\n_LOG.info(\"Server thread alive: %s\", server_thread.is_alive())\n# Outcome: `False`; the server thread has exited and the port is freed.","key":"pVgVvVBeBt"},{"type":"outputs","id":"Me_uzhGaUYRvgytUWJlF0","key":"r71lO2LYBR","children":[]}],"key":"KyBNstuIw3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Wrap-up","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JaUUEUcGgm"}],"identifier":"wrap-up","label":"Wrap-up","html_id":"wrap-up","implicit":true,"key":"IWqSTXKyZ5"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"This notebook covered the full lifecycle of a ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ps5JqDU22n"},{"type":"inlineCode","value":"FastAPI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TZcVAlM8cS"},{"type":"text","value":" service: build the\napp, serve it with ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"opQ6McbVES"},{"type":"inlineCode","value":"uvicorn","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dc3ai3SHPc"},{"type":"text","value":", call it over real HTTP, and shut it down\ncleanly. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eRHZKcNEPG"},{"type":"inlineCode","value":"README.md","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"j8lnAtj2uE"},{"type":"text","value":" for how to run the same app from the command line\nwith ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cxEDqSJT7i"},{"type":"inlineCode","value":"uvicorn fastapi_utils:app --reload","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HHGCwXRXlq"},{"type":"text","value":" instead of from a notebook.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"w9ItecuBbi"}],"key":"jqB9VbjhVx"}],"key":"u8uZNF3t2R"}],"key":"VS9FkTjIzE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"FastAPI API Overview","url":"/fastapi-api","group":"data science packages"},"next":{"title":"gCastle Tutorial","url":"/readme-20","group":"data science packages"}}},"domain":"http://localhost:3000"}