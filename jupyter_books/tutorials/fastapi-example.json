ckground()","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ax9Z1EyJpE"},{"type":"text","value":" serves it with a real\n","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ERqVdYBRBm"},{"type":"inlineCode","value":"uvicorn","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"wOsHATxDVW"},{"type":"text","value":" server, on a background thread so the rest of the notebook can\nkeep running","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lw1sDxEee4"}],"key":"lC2f3nhyGX"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"inlineCode","value":"httpx","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"iT9xlhCOqJ"},{"type":"text","value":" drives the app over real HTTP, the same way a browser or another\nservice would","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Ih5uyqBJZd"}],"key":"tV6J79lVfc"}],"key":"SYrTn4yuTV"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"This is the production-shaped path.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"ymEpkje0M1"}],"key":"w2u6H5Pg2m"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"inlineCode","value":"fastapi.API.ipynb","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"U5Vy7F19f4"},{"type":"text","value":" covers the same app’s building blocks in-process with\n","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"Pg38XlTxpT"},{"type":"inlineCode","value":"TestClient","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"c7XdKLCHVx"},{"type":"text","value":", which is faster for exploration but skips the network entirely.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"BtzY62EFz9"}],"key":"s6WAQI50Cz"}],"key":"zFx8HqFplT"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Must run top to bottom after a kernel restart.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"WViSzEnNOn"}],"key":"qsaYk8XmHq"}],"key":"piF2pZ9wna"}],"key":"v1uNt9ZEXf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"!pip install --quiet -r tutorial_requirements.txt","key":"b6Z4XWYeGg"},{"type":"outputs","id":"lSrdCC5_QoFrJvYTfkEHS","key":"s4D2e1EBIY","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"\u001b[33mWARNING: Running pip as the 'root' user can result in broken permissions and conflicting behaviour with the system package manager, possibly rendering your system unusable. It is recommended to use a virtual environment instead: https://pip.pypa.io/warnings/venv. Use the --root-user-action option if you know what you are doing and want to suppress this warning.\u001b[0m\u001b[33m\n\u001b[0m"},"children":[]}]}],"key":"rIDgWyimgK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"%load_ext autoreload\n%autoreload 2\n\nimport logging\n\nimport httpx\n\nimport fastapi_utils\nimport helpers.hdbg as hdbg\nimport helpers.hintrospection as hintros\n\nhdbg.init_logger(verbosity=logging.INFO)\n_LOG = logging.getLogger(__name__)\n\nPORT = 8010\nBASE_URL = f\"http://127.0.0.1:{PORT}\"","key":"gV366aU6Ym"},{"type":"outputs","id":"PccUeJZeerlBvsDu9BUyM","key":"BOHBjvaOzT","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The autoreload extension is already loaded. To reload it, use:\n  %reload_ext autoreload\n\u001b[0m\u001b[33mWARNING\u001b[0m: Logger already initialized: skipping\n"},"children":[]}]}],"key":"gEIkFfEODj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 1: Build the App","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XUUHuk7ut5"}],"identifier":"part-1-build-the-app","label":"Part 1: Build the App","html_id":"part-1-build-the-app","implicit":true,"key":"spMI49lZjc"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"create_book_app()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Pd0IBxHR0u"},{"type":"text","value":" wires up the routes and seeds an in-memory catalog.\nListing ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Vi1zxPsJjj"},{"type":"inlineCode","value":"app.routes","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"c7m9ZWCyZP"},{"type":"text","value":" shows exactly what got registered, which is a useful\nsanity check before starting the server.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Mhwp6BgEIz"}],"key":"Kz4Madcst6"}],"key":"I2x0UFS7JA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"hintros.print_obj_info(fastapi_utils.create_book_app)","key":"O9jlA2Rf8M"},{"type":"outputs","id":"657LR6K6x7KX0QMQ6O8Zg","key":"pZz1RBjArC","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/markdown":{"content":"**function**","content_type":"text/markdown"},"text/plain":{"content":"<IPython.core.display.Markdown object>","content_type":"text/plain"}}},"children":[]},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"https://github.com/gpsaggese/gpsaggese.github.io/blob/gp_scratch/tutorials/fastapi/fastapi_utils.py#L94\n"},"children":[]}]}],"key":"YKTSqyyjkm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Build the app: wires up the routes and seeds the in-memory catalog.\napp = fastapi_utils.create_book_app()\n\nfor route in app.routes:\n    methods = \",\".join(sorted(getattr(route, \"methods\", []) or []))\n    _LOG.info(\"%-6s %s\", methods, getattr(route, \"path\", route))\n# Outcome: `app` is a ready-to-serve `FastAPI` instance; the log lists every\n# registered route, including the built-in `/docs`, `/redoc`, and\n# `/openapi.json`, plus the catalog's `/health` and `/books` routes.","key":"YMSks034IE"},{"type":"outputs","id":"Ggy957kIqqI905F-o86yg","key":"QMezm20YtN","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"INFO  GET,HEAD /openapi.json\nINFO  GET,HEAD /docs\nINFO  GET,HEAD /docs/oauth2-redirect\nINFO  GET,HEAD /redoc\nINFO  GET    /health\nINFO  GET    /books\nINFO  GET    /books/{book_id}\nINFO  POST   /books\nINFO  PATCH  /books/{book_id}\nINFO  DELETE /books/{book_id}\n"},"children":[]}]}],"key":"plrGuh6ejG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 2: Start the Server","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wfs9VC2Qv3"}],"identifier":"part-2-start-the-server","label":"Part 2: Start the Server","html_id":"part-2-start-the-server","implicit":true,"key":"gWyVhc3NRu"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"inlineCode","value":"run_server_in_background()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vB93N9vUEx"},{"type":"text","value":" starts ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Nf7qTgTut5"},{"type":"inlineCode","value":"uvicorn","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WqNEYzBytE"},{"type":"text","value":" on a daemon thread.\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qjzfvOcf67"},{"type":"inlineCode","value":"wait_for_server()","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Wml1HC1th3"},{"type":"text","value":" polls ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EtxYdc8sm7"},{"type":"inlineCode","value":"/health","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"McMEP6rFJE"},{"type":"text","value":" until the socket accepts connections,\nso the next cell never races the server startup.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ct9QFHCtlD"}],"key":"H48GArWZa8"}],"key":"eyMPbpPpto"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Start `uvicorn` on a daemon thread, then block until `/health` responds.\nserver, server_thread = fastapi_utils.run_server_in_background(app, port=PORT)\nfastapi_utils.wait_for_server(f\"{BASE_URL}/health\")\n_LOG.info(\"Server is up at %s\", BASE_URL)\n# Outcome: the server is accepting real TCP connections at `BASE_URL`.","key":"HRzNAKNnUY"},{"type":"outputs","id":"yvPjDcsTozQcYg5Xzw2cI","key":"SO6tb2F2PR","children":[]}],"key":"WdISLOZQij"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 3: List and Filter Books","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cri3KCeDHW"}],"identifier":"part-3-list-and-filter-books","label":"Part 3: List and Filter Books","html_id":"part-3-list-and-filter-books","implicit":true,"key":"FO8fPAY3p6"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"These are real HTTP requests: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lE1J7nxrwa"},{"type":"inlineCode","value":"httpx","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OJrRaue3BR"},{"type":"text","value":" opens a TCP connection to\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vitZlgxQCb"},{"type":"inlineCode","value":"127.0.0.1:8010","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Bot5xqARod"},{"type":"text","value":" instead of calling the app object directly.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"B7Xe1l7k0I"}],"key":"LmTKsby7lN"}],"key":"vd6azqwuJs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# List every book in the catalog.\nresponse = httpx.get(f\"{BASE_URL}/books\")\nresponse.raise_for_status()\n_LOG.info(\"All books: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: all 3 seeded books, in insertion order.\n\n# Filter to only out-of-stock books via the `in_stock` query parameter.\nresponse = httpx.get(f\"{BASE_URL}/books\", params={\"in_stock\": False})\n_LOG.info(\"Out-of-stock books: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: just \"Designing Data-Intensive Applications\", the only seed book\n# marked out of stock.\n\n# Cap the result to one book via the `limit` query parameter.\nresponse = httpx.get(f\"{BASE_URL}/books\", params={\"limit\": 1})\n_LOG.info(\"First book only: %s\", [book[\"title\"] for book in response.json()])\n# Outcome: only \"Fluent Python\", the first seeded book.","key":"jArFn9T6dX"},{"type":"outputs","id":"Nsekw7Dt_8G04hvpz4I0s","key":"Tl3HjT9LMw","children":[]}],"key":"fqz8Sa60dm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 4: Create, Update, and Delete a Book","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zcZfVpd2LT"}],"identifier":"part-4-create-update-and-delete-a-book","label":"Part 4: Create, Update, and Delete a Book","html_id":"part-4-create-update-and-delete-a-book","implicit":true,"key":"YN2notWHUn"}],"key":"TFhWFDX4Sw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create a new book; the server assigns the `id`.\nresponse = httpx.post(\n    f\"{BASE_URL}/books\",\n    json={\"title\": \"The Pragmatic Programmer\", \"author\": \"Hunt & Thomas\", \"year\": 1999},\n)\nresponse.raise_for_status()\nnew_book = response.json()\n_LOG.info(\"Created book %s: %s\", new_book[\"id\"], new_book[\"title\"])\n# Outcome: 201 Created; `new_book[\"id\"]` is 4, the next free ID after the\n# 3 seeded books.","key":"YLib5M10G4"},{"type":"outputs","id":"bNoJ5qSq5JIJGXixVLKX4","key":"x11qq4ONjw","children":[]}],"key":"F1Wq02vELs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Replace the new book's fields, flipping it to out of stock.\nresponse = httpx.patch(\n    f\"{BASE_URL}/books/{new_book['id']}\",\n    json={\n        \"title\": new_book[\"title\"],\n        \"author\": new_book[\"author\"],\n        \"year\": new_book[\"year\"],\n        \"in_stock\": False,\n    },\n)\nresponse.raise_for_status()\n_LOG.info(\"Updated book: %s\", response.json())\n# Outcome: 200 OK; the same book is returned with `in_stock` now `False`.","key":"gHf1j6J9S7"},{"type":"outputs","id":"v1e6nicXy9VHsYN0p1qDO","key":"KjYyaIV2t6","children":[]}],"key":"v5skHoYFQI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Delete the book that was just created and updated.\nresponse = httpx.delete(f\"{BASE_URL}/books/{new_book['id']}\")\n_LOG.info(\"DELETE status: %s\", response.status_code)\n# Outcome: 204 No Content; the book is removed from the catalog.\n\n# Confirm the deletion: the same ID should no longer resolve.\nresponse = httpx.get(f\"{BASE_URL}/books/{new_book['id']}\")\n_LOG.info(\"GET after delete: %s\", response.status_code)\n# Outcome: 404 Not Found.","key":"sv82pU9oIw"},{"type":"outputs","id":"5Ldf_lyxfLynVO1P3s0QD","key":"hLhKX5morO","children":[]}],"key":"KKyY3vJ1tp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 5: Handle Errors","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"huhgtwQ8MH"}],"identifier":"part-5-handle-errors","label":"Part 5: Handle Errors","html_id":"part-5-handle-errors","implicit":true,"key":"BGebsCcBns"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"A missing book returns ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Xwt6HPn1nX"},{"type":"inlineCode","value":"404","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ssCTIhShZR"},{"type":"text","value":"; an invalid payload never reaches the handler\nand returns ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"L7phyFfoB0"},{"type":"inlineCode","value":"422","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nfF2kn4RLB"},{"type":"text","value":" with a description of what failed.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Cb2shCnixf"}],"key":"Blu76FLYUT"}],"key":"cGmyz2cpGI"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Look up a book ID that was never created.\nresponse = httpx.get(f\"{BASE_URL}/books/99999\")\n_LOG.info(\"GET missing book -> %s %s\", response.status_code, response.json())\n# Outcome: 404 Not Found with {\"detail\": \"Book 99999 not found\"}.\n\n# Send a payload missing the required `author` and `year` fields.\nresponse = httpx.post(f\"{BASE_URL}/books\", json={\"title\": \"No Author or Year\"})\n_LOG.info(\"POST invalid payload -> %s\", response.status_code)\nfor error in response.json()[\"detail\"]:\n    _LOG.info(\"  %s: %s\", error[\"loc\"], error[\"msg\"])\n# Outcome: 422 Unprocessable Entity; the handler never runs, and the\n# response lists both missing fields.","key":"vTGNAjJpsc"},{"type":"outputs","id":"6Bfzo1kdkqCxddGUicOjG","key":"OFEGDOAQMi","children":[]}],"key":"l6PWo3R9gE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 6: Inspect the Live Docs","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OGvH52oGDU"}],"identifier":"part-6-inspect-the-live-docs","label":"Part 6: Inspect the Live Docs","html_id":"part-6-inspect-the-live-docs","implicit":true,"key":"PZRe5et3P8"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"With the server running, ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TLor1zTyMJ"},{"type":"inlineCode","value":"/openapi.json","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Nzf9ytLdV4"},{"type":"text","value":" is reachable over HTTP, and so are\nthe human-facing ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nd9gtbuKWx"},{"type":"inlineCode","value":"/docs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fKazj3ullm"},{"type":"text","value":" (Swagger UI) and ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"z6LNtZHU2G"},{"type":"inlineCode","value":"/redoc","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hO00tAHVd0"},{"type":"text","value":" pages. Point a browser at\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sPd6xS3heS"},{"type":"inlineCode","value":"http://127.0.0.1:8010/docs","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OQlqPnwp1K"},{"type":"text","value":" while this notebook’s server is up to try it\ninteractively.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PMCjVAmJI5"}],"key":"jMm8jouZXa"}],"key":"oxPlyNFa9P"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Fetch the OpenAPI schema `FastAPI` generated automatically.\nresponse = httpx.get(f\"{BASE_URL}/openapi.json\")\nschema = response.json()\n_LOG.info(\"OpenAPI title: %s\", schema[\"info\"][\"title\"])\n_LOG.info(\"Registered paths: %s\", sorted(schema[\"paths\"].keys()))\n# Outcome: title \"Book Catalog API\"; paths are /books, /books/{book_id},\n# and /health.","key":"N5ulk5GRtl"},{"type":"outputs","id":"Gt-OC9Ks02_BPdV8LVtUo","key":"VfSnUyjQXO","children":[]}],"key":"xhQFSLNDsu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 7: Shut Down the Server","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YTjRUxixNf"}],"identifier":"part-7-shut-down-the-server","label":"Part 7: Shut Down the Server","html_id":"part-7-shut-down-the-server","implicit":true,"key":"nItNNte9wg"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Always stop the background server before the kernel exits, so the port is\nfreed for the next run.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"O73A4CEudJ"}],"key":"HBlBizQ4yH"}],"key":"UBFr4sJnXc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Stop the background `uvicorn` server and join its thread.\nfastapi_utils.stop_server(server, server_thread)\n_LOG.info(\"Server thread alive: %s\", server_thread.is_alive())\n# Outcome: `False`; the server thread has exited and the port is freed.","key":"VvTz5tKwb8"},{"type":"outputs","id":"1M2AAKiCPfLtYH_V9qs-d","key":"Z8cSQIeRd2","children":[]}],"key":"zqPFL197Q0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Wrap-up","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nHSqFEyUaf"}],"identifier":"wrap-up","label":"Wrap-up","html_id":"wrap-up","implicit":true,"key":"rEV8kpEHmy"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"This notebook covered the full lifecycle of a ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"h4RYVImmsb"},{"type":"inlineCode","value":"FastAPI","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"O9Sdupkq2t"},{"type":"text","value":" service: build the\napp, serve it with ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LfPXl30inh"},{"type":"inlineCode","value":"uvicorn","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"M0YCSoWN2C"},{"type":"text","value":", call it over real HTTP, and shut it down\ncleanly. See ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"CnhcC4sX1G"},{"type":"inlineCode","value":"README.md","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"n3XPl1HJCB"},{"type":"text","value":" for how to run the same app from the command line\nwith ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VK3rlyM7xt"},{"type":"inlineCode","value":"uvicorn fastapi_utils:app --reload","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ala66CFUbs"},{"type":"text","value":" instead of from a notebook.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"v6oYJtexfb"}],"key":"Y7o4mvyCL3"}],"key":"HuPe5bnnDv"}],"key":"OM8ER8ozBT"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"FastAPI API Overview","url":"/fastapi-api","group":"data science packages"},"next":{"title":"gCastle Tutorial","url":"/readme-20","group":"data science packages"}}},"domain":"http://localhost:3000"}