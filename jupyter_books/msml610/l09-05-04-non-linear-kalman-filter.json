 (linearized mean, cheap but biased\nfor a nonlinear ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"DorslhTmzY"},{"type":"inlineCode","value":"f","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"HQGNWBiwdo"},{"type":"text","value":"), vs averaging ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"w4FhExXxUW"},{"type":"inlineCode","value":"f","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"fRBQImEBm9"},{"type":"text","value":" over many samples (Monte\nCarlo mean, accurate but expensive)","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"uRdoSY9NPo"}],"key":"psjDQN2Ixi"}],"key":"h5Ulb4t6jf"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"strong","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Implementation","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"g0CYC6BiRe"}],"key":"rcAzC4VhUl"},{"type":"text","value":" ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"mxCl7Jh8a2"},{"type":"inlineCode","value":"utils.plot_monte_carlo_mean(...)","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"U9XKQTGPHY"}],"key":"T3bnvyzYDf"}],"key":"E20ztkGOG4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Create a Gaussian.\nN = 10000\nmean = (0.0, 0.0)\np = np.array([[32.0, 15.0], [15.0, 40.0]])\nxs, ys = multivariate_normal(mean=mean, cov=p, size=N).T\n\n# Compute linearized mean.\nmean1 = f_nonlinear_xy(np.mean(xs), np.mean(ys))\n_LOG.info(\"f(mean)=%s\", mean1)\nmean2 = np.mean(\n    [f_nonlinear_xy(xs_tmp, ys_tmp) for xs_tmp, ys_tmp in zip(xs, ys)], axis=0\n)\n_LOG.info(\"mean(f)=%s\", mean2)\n# Plot both.\nutils.plot_monte_carlo_mean(xs, ys, f_nonlinear_xy, mean1, \"Linearized Mean\")","key":"bYnKM910dB"},{"type":"outputs","id":"ZRBDHf_8hBh3dCsftKBCW","key":"rJV8Q6KXZW","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"INFO:__main__:f(mean)=[0.06708904 0.00185213]\nINFO:__main__:mean(f)=[ 0.06708904 43.25045478]\n"},"children":[]},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"c2ddf265026a656cfa1a76755d993c0e","path":"/jupyter_books/msml610/build/c2ddf265026a656cfa1a76755d993c0e.png"},"text/plain":{"content":"<Figure size 800x300 with 2 Axes>","content_type":"text/plain"}}},"children":[]}]}],"key":"pM4c1qfGHO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Part 3: The Unscented Transform","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"h29qpVpa98"}],"identifier":"part-3-the-unscented-transform","label":"Part 3: The Unscented Transform","html_id":"part-3-the-unscented-transform","implicit":true,"key":"dzK4I9Vlwg"}],"key":"OaH23f3XlH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Cell 3.1: Generating sigma points","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"i42YHU5vn9"}],"identifier":"cell-3-1-generating-sigma-points","label":"Cell 3.1: Generating sigma points","html_id":"cell-3-1-generating-sigma-points","implicit":true,"key":"mUwqkGovKh"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Goal","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WtU1YhZtiP