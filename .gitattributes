*.pdf filter=lfs diff=lfs merge=lfs -text
*.html filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text

# Keep Linux line endings for the files that run inside a container, also on
# Windows checkouts with `core.autocrlf=true`.
*.sh text eol=lf
bashrc text eol=lf
etc_sudoers text eol=lf
