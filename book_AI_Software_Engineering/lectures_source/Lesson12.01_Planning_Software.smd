          fontname="Helvetica", fontsize=11, margin="0.12,0.07",
          height=0.40];
    edge [color="#A3B1C0", penwidth=1.3, arrowhead=vee, arrowsize=0.75,
          fontname="Helvetica", fontsize=10, fontcolor="#7B8794"];

    // phase : teal | human gate : rose edge label

    Define [label=<<b>Define</b><br/>PRD, design>,
            fillcolor="#B7DDD0", color="#6FA890", fontcolor="#1F4E39"];
    Plan   [label=<<b>Plan</b><br/>plan, tasks, specs>,
            fillcolor="#B7DDD0", color="#6FA890", fontcolor="#1F4E39"];
    Build  [label=<<b>Build</b><br/>one PR at a time>,
            fillcolor="#B7DDD0", color="#6FA890", fontcolor="#1F4E39"];
    Close  [label=<<b>Close</b><br/>update the docs>,
            fillcolor="#B7DDD0", color="#6FA890", fontcolor="#1F4E39"];

    Define -> Plan [label="  Approve scope\n  and design  ",
                    color="#C0455B", fontcolor="#C0455B", penwidth=1.6];
    Plan -> Build  [label="  Approve plan\n  and specs  ",
                    color="#C0455B", fontcolor="#C0455B", penwidth=1.6];
    Build -> Close [label="  Review\n  and merge  ",
                    color="#C0455B", fontcolor="#C0455B", penwidth=1.6];
    Close -> Build [style=dashed, color="#8C8C8C", fontcolor="#7B8794",
                    label="  Next PR, after\n  checking the logs  "];
}
```
