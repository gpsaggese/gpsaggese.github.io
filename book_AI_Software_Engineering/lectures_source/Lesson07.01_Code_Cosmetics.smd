    // advice : violet | local automation : green | remote : blue
    // human : orange

    Guide  [label="1. Style guide: read by a human",
            fillcolor="#E9E1F7", color="#A88FD9", fontcolor="#45296B"];
    Rules  [label="2. Rules file: read by the agent",
