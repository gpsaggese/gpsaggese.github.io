  rows: (
    ("Loop runs in", "Terminal, cloud, CI", "IDE, code host, CLI", "Own editor, CLI"),
    ("Instructions", "CLAUDE.md", "Repository instructions", "Rules files"),
    ("Extension", "MCP, hooks, skills, subagents, SDK", "MCP, extensions", "MCP, rules"),
