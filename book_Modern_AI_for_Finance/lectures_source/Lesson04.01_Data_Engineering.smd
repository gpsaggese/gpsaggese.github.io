    ("Restatements", "15% revised 20 to 80 days after release", "Vintages"),
    ("Delistings", "36% of stocks, cheap ones more often", "Universe"),
    ("Splits, dividends", "One stock: 2 splits, 80 dividends", "Adjust on read"),
    ("Clocks", "New York and London local time", "UTC"),
  ),
  col-widths: (1fr, 2.2fr, 1fr),
