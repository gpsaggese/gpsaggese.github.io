\draw[dotted, gray] (2.4,2.9) -- (2.4,0.45);
\draw[dotted, gray] (6.1,2.9) -- (6.1,0.45);
\draw[<->, cCoral, line width=0.8pt] (2.4,0.55) -- (6.1,0.55);
\node[cCoral, above] at (4.25,0.55) {drawdown duration};
\end{scope}
```

\footnotesize _Equity curve with its high watermark, maximum drawdown, and
drawdown duration_
::::
