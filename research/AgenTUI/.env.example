# Copy to .env and fill in your API key before running the CLI.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-4o-mini when unset.
# See src/models.ts for the full list of supported ids.
# OPENAI_MODEL=gpt-5-mini

# Optional system prompt override. Defaults to DEFAULT_SYSTEM_PROMPT in
# src/config/index.ts when unset.
# SYSTEM_PROMPT=
