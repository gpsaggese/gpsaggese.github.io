# Copy this file to `.env` (ignored by Git) and adjust as needed.

# Local development with Ollama (default; no API key needed).
HOUSING_LLM_PROVIDER=ollama
HOUSING_LLM_MODEL=qwen3:4b
HOUSING_LLM_BASE_URL=http://host.docker.internal:11434/v1
HOUSING_LLM_TIMEOUT=180

# GroqCloud Free plan (hosted; create a key at console.groq.com).
# HOUSING_LLM_PROVIDER=groq
# HOUSING_LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=<your-key>

# Retries for failed requests such as rate-limit (429) errors.
# HOUSING_LLM_MAX_RETRIES=2

# Optional validation with the OpenAI API (paid).
# HOUSING_LLM_PROVIDER=openai
# HOUSING_LLM_MODEL=<openai-model-name>
# HOUSING_LLM_BASE_URL=
# OPENAI_API_KEY=<your-key>
