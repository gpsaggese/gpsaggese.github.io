"title" value="Decision-aware knowledge QA: Offline detail" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="700" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="core pipeline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1030" y="4" width="150" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="added or changed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1190" y="4" width="150" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="output or evaluation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1350" y="4" width="170" height="24" as="geometry"/></mxCell><mxCell id="lg3" value="abstention" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1530" y="4" width="110" height="24" as="geometry"/></mxCell><mxCell id="laneL" value="Offline: build once per repository, at a pinned commit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1620" height="520" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;1 · Repository&lt;/b&gt;&lt;br&gt;eclipse-edc/Connector&lt;br&gt;10 records, one commit" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="190" height="110" as="geometry"/></mxCell><mxCell id="parser" value="&lt;b&gt;3 · ADR parser&lt;/b&gt;&lt;br&gt;title, sections, links&lt;br&gt;(markdown-it-py + regex)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="350" y="120" width="190" height="110" as="geometry"/></mxCell><mxCell id="extractor" value="&lt;b&gt;4 · Relation extractor&lt;/b&gt;&lt;br&gt;language model finds&lt;br&gt;supersedes / superseded by&lt;br&gt;quote + real record needed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="190" height="110" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;5 · Decision store&lt;/b&gt;&lt;br&gt;fields · references&lt;br&gt;supersedes (+ evidence)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="890" y="120" width="190" height="110" as="geometry"/></mxCell><mxCell id="linker" value="&lt;b&gt;6 · Linker&lt;/b&gt;&lt;br&gt;mentions ∪ ADR commit files&lt;br&gt;one relation: governs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1160" y="120" width="190" height="110" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;7 · Decision graph&lt;/b&gt;&lt;br&gt;supersedes · governs&lt;br&gt;references" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1430" y="120" width="190" height="110" as="geometry"/></mxCell><mxCell id="git" value="&lt;b&gt;2 · GitStore&lt;/b&gt;&lt;br&gt;git log --follow +&lt;br&gt;git objects&lt;br&gt;no PyDriller, no checkout" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="190" height="110" as="geometry"/></mxCell><mxCell id="index" value="&lt;b&gt;10 · Hybrid index&lt;/b&gt;&lt;br&gt;ADR fields, whole records,&lt;br&gt;code, README&lt;br&gt;Chroma embeddings + BM25" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="890" y="410" width="190" height="110" as="geometry"/></mxCell><mxCell id="stale" value="&lt;b&gt;8 · Staleness scorer&lt;/b&gt;&lt;br&gt;commits ÷ (1 + ADR edits)&lt;br&gt;warn at 15" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1160" y="410" width="190" height="110" as="geometry"/></mxCell><mxCell id="gaps" value="&lt;b&gt;9 · Gap ranker&lt;/b&gt;&lt;br&gt;complexity × (1 − coverage)&lt;br&gt;(lizard) → gap report" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1430" y="410" width="190" height="110" as="geometry"/></mxCell><mxCell id="settings" value="&lt;b&gt;Settings you can change&lt;/b&gt;&lt;br&gt;Extractor: model, 9,000-character input limit, prompt     ·     Linker: which signals are used     ·     Staleness: formula, warning threshold (15)&lt;br&gt;Chunks: 400-token fields, 300-token windows, 50 overlap     ·     Search: 20 candidates per method, merged with RRF (k = 60), embedding model&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;GitStore (2) feeds the linker, the staleness scorer, the gap ranker and the index through the four arrows leaving its top edge&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="80" y="610" width="1540" height="130" as="geometry"/></mxCell><mxCell id="a1" value="ADR folder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="repo" target="parser"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="record text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="parser" target="extractor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="supersedes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="extractor" target="store"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="fields, links" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="parser" target="store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445.0" y="98"/><mxPoint x="985.0" y="98"/></Array></mxGeometry></mxCell><mxCell id="a5" value="records" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="store" target="linker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="governs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="linker" target="graph"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a7" value="supersedes, references" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="store" target="graph"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1042.0" y="88"/><mxPoint x="1525.0" y="88"/></Array></mxGeometry></mxCell><mxCell id="a8" value="read via" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="repo" target="git"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="git" target="index"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="232.0" y="350"/><mxPoint x="928.0" y="350"/></Array></mxGeometry></mxCell><mxCell id="a10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="git" target="stale"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="232.0" y="350"/><mxPoint x="1198.0" y="350"/></Array></mxGeometry></mxCell><mxCell id="a11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="git" target="gaps"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="232.0" y="350"/><mxPoint x="1468.0" y="350"/></Array></mxGeometry></mxCell><mxCell id="a12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="git" target="linker"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="232.0" y="350"/><mxPoint x="1274.0" y="350"/></Array></mxGeometry></mxCell><mxCell id="a13" value="ADR text" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="store" target="index"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a14" value="coverage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="graph" target="gaps"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a15" value="linked files" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#f9f9f9;" edge="1" parent="1" source="graph" target="stale"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1468.0" y="300"/><mxPoint x="1312.0" y="300"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="online" name="3 Online detail"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Decision-aware knowledge QA: Online detail" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="700" height="30" as="geometry"/></mxCell><mxCell id="lg0" value="core pipeline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1250" y="4" width="150" height="24" as="geometry"/></mxCell><mxCell id="lg1" value="added or changed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1410" y="4" width="150" height="24" as="geometry"/></mxCell><mxCell id="lg2" value="output or evaluation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1570" y="4" width="170" height="24" as="geometry"/></mxCell><mxCell id="lg3" value="abstention" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1750" y="4" width="110" height="24" as="geometry"/></mxCell><mxCell id="laneL" value="Online: answer a question" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#bbbbbb;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1840" height="600" as="geometry"/></mxCell><mxCell id="q" value="&lt;b&gt;1 · Developer question&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="315" width="130" height="70" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;2 · Query router&lt;/b&gt;&lt;br&gt;model chooses graph, adr or code&lt;br&gt;code checks names and paths&lt;br&gt;keyword rules as fallback" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="250" y="270" width="230" height="160" as="geometry"/></mxCell><mxCell id="graphL" value="&lt;b&gt;3a · Graph lookup&lt;/b&gt;&lt;br&gt;ten exact lookups, no search&lt;br&gt;e.g. what replaced a record,&lt;br&gt;which decisions govern a file&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;reads: decision graph, stale scores&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="260" height="120" as="geometry"/></mxCell><mxCell id="adrR" value="&lt;b&gt;3b · ADR search&lt;/b&gt;&lt;br&gt;BM25 + embeddings, top 8&lt;br&gt;Rationale × 1.2 for design intent&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;reads: hybrid index&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="260" height="120" as="geometry"/></mxCell><mxCell id="codeR" value="&lt;b&gt;3c · Code search&lt;/b&gt;&lt;br&gt;BM25 + embeddings, top 6&lt;br&gt;+ top 3 governing ADR fields&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;reads: hybrid index, git blame&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="560" y="480" width="260" height="120" as="geometry"/></mxCell><mxCell id="expand" value="&lt;b&gt;4 · Graph expansion&lt;/b&gt;&lt;br&gt;add governing records, linked code&lt;br&gt;follow replacement chains (3 hops)&lt;br&gt;attach staleness warnings&lt;br&gt;trim to 6,000 tokens&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;reads: decision graph, stale scores&lt;/font&gt;&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="900" y="300" width="240" height="240" as="geometry"/></mxCell><mxCell id="llm" value="&lt;b&gt;5 · Answer model&lt;/b&gt;&lt;br&gt;cites source IDs&lt;br&gt;(SYSTEM_PROMPT)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1190" y="360" width="180" height="120" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;6 · Supported?&lt;/b&gt;&lt;br&gt;in context&lt;br&gt;entailment ≥ 0.5" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1420" y="320" width="200" height="200" as="geometry"/></mxCell><mxCell id="answer" value="&lt;b&gt;7 · Answer&lt;/b&gt;&lt;br&gt;citations + warnings" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1700" y="220" width="160" height="90" as="geometry"/></mxCell><mxCell id="plain" value="&lt;b&gt;Plain-words summary&lt;/b&gt;&lt;br&gt;optional rewrite" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1700" y="350" width="160" height="80" as="geometry"/></mxCell><mxCell id="abstain" value="&lt;b&gt;7 · Abstain&lt;/b&gt;&lt;br&gt;No recorded rationale&lt;br&gt;+ sources checked" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1700" y="480" width="160" height="90" as="geometry"/></mxCell><mxCell id="settings" value="&lt;b&gt;Settings you can change&lt;/b&gt;&lt;br&gt;Router: model or keyword rules, ten graph lookups, design-intent flag     ·     Search: top 8 ADR, top 6 code, 20 candidates per method, RRF k = 60, Rationale boost 1.2&lt;br&gt;Expansion: 3 linked files, 3 chain hops, 6,000-token limit     ·     Answer: model, SYSTEM_PROMPT, PLAIN_PROMPT     ·     Verifier: entailment threshold 0.5, 3-sentence evidence windows&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#666666&quot;&gt;An answer is abstained when the model says there is no recorded rationale, or when every sentence fails the check (B4 only)&lt;/font&gt;&lt;/i&gt;" style