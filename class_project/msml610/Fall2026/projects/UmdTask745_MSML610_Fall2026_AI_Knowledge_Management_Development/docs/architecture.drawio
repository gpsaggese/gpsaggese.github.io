etry"/></mxCell><mxCell id="q" value="&lt;b&gt;Question&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="180" height="90" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;Choose a route&lt;/b&gt;&lt;br&gt;graph, ADR text or code" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="320" y="520" width="180" height="90" as="geometry"/></mxCell><mxCell id="retrieve" value="&lt;b&gt;Look up or search&lt;/b&gt;&lt;br&gt;reads the index or graph" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="520" width="180" height="90" as="geometry"/></mxCell><mxCell id="expand" value="&lt;b&gt;Add context&lt;/b&gt;&lt;br&gt;replacements, linked code, warnings" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="520" width="180" height="90" as="geometry"/></mxCell><mxCell id="answer" value="&lt;b&gt;Write a cited answer&lt;/b&gt;&lt;br&gt;language model" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="980" y="520" width="180" height="90" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;Check each sentence&lt;/b&gt;&lt;br&gt;supported by its source?" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1200" y="520" width="180" height="90" as="geometry"/></mxCell><mxCell id="outcome" value="&lt;b&gt;Answer + warnings&lt;/b&gt;&lt;br&gt;or abstain" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="520" width="