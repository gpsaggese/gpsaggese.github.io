          fontname="Helvetica", fontsize=9, fontcolor="#7B8794"];

    // red = selection path (also updated by backprop), green = new node
    // (expansion), orange = rollout (simulation, discarded after use)
    Root [label="root\nN: 40 -> 41"];
    A    [label="A\nN=25"];
    B    [label="B\nN: 12 -> 13", color="#B23A48", penwidth=2.2];
    C    [label="C\nN=3"];
    B1   [label="B1\nN=7"];
    B2   [label="B2\nN: 5 -> 6", color="#B23A48", penwidth=2.2];
    New  [label="new child\nN: 0 -> 1", fillcolor="#A9DDB0", color="#4F9A5C",
          fontcolor="#1F4E2E"];
    Rollout [label="rollout to terminal\n(discarded)", shape=note,
             fillcolor="#FFC98A", color="#D98E2B", fontcolor="#6B4517"];

    Root -> A;
    Root -> B [color="#B23A48", penwidth=2.2, label="  1. Select  ",
               fontcolor="#B23A48"];
    Root -> C;
    B -> B1;
    B -> B2 [color="#B23A48", penwidth=2.2];
    B2 -> New [color="#4F9A5C", penwidth=1.8, label="  2. Expand  ",
