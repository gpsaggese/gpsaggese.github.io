          height=0.48];

    edge [color="#A3B1C0",
          penwidth=1.3,
          arrowhead=vee,
          arrowsize=0.75,
          fontname="Helvetica",
          fontsize=9,
          fontcolor="#7B8794"];

    // Nodes representing the RDF example
    Book [label="Book123\n(Subject)", fillcolor="#A9DDB0", color="#4F9A5C", fontcolor="#1F4E2E"];
    Author [label="Author456\n(Entity)", fillcolor="#9CC4F2", color="#3C6FB0", fontcolor="#1F4E79"];
    Title [label="\"The Great Gatsby\"\n(Literal)", fillcolor="#FFC98A", color="#D98E2B", fontcolor="#6B4517"];
    Year [label="\"1925\"\n(Literal)", fillcolor="#FFC98A", color="#D98E2B", fontcolor="#6B4517"];
    Genre [label="\"Fiction\"\n(Literal)", fillcolor="#FFC98A", color="#D98E2B", fontcolor="#6B4517"];
    Name [label="\"F. Scott Fitzgerald\"\n(Literal)", fillcolor="#FFC98A", color="#D98E2B", fontcolor="#6B4517"];

    // Edges with predicates
    Book -> Title [label="hasTitle"];
    Book -> Author [label="hasAuthor"];
    Author -> Name [label="hasName"];
    Book -> Year [label="publishedYear"];
    Book -> Genre [label="belongsToGenre"];
}
```

* SPARQL

- @Definition@: **SPARQL** (2008) `#cite("prudhommeaux2008sparql")`{=typst}
  - Is the query language for RDF data
  - Allows retrieval and manipulation of data stored in RDF format

- @Components@
  - _Triple Patterns_: query fragments matching triples in RDF graph
  - _Basic Graph Pattern_: set of triple patterns
  - _Variables_: stand in for unknown parts (e.g., `?person`, `?animal`)

- **Main query types**
  - `SELECT`: retrieve specific variables
  - `CONSTRUCT`: create new RDF triples from results
  - `ASK`: boolean indicating if pattern exists
  - `DESCRIBE`: return RDF graph describing resources

- @Example@: _"Find all resources of type Bird"_
  ```
  SELECT ?animal WHERE { ?animal rdf:type ex:Bird }
  ```

# Knowledge Graphs & The Semantic Web

* Semantic Web

- @Definition@: **Semantic Web**
  - Extends the Web for machine understanding
  - Adds meaning/semantics for integration and discovery
  - Addresses HTML's lack of semantic structure for computers

::: columns
:::: {.column width=55%}

- @Components@:
  - RDF: base data model
  - SPARQL: query language
  - OWL: rich ontologies

- @Current status@:
  - Core ideas widely adopted
  - Full vision partially realized

- @Challenges@:
  - Adoption complexity, privacy, ownership
  - Standardization, scalability, centralization

::::
:::: {.column width=45%}

