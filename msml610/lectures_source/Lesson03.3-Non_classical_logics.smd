    mammal [label="Mammal", fillcolor="#A0D6D1"];
    fido [label="Fido\n(instance)", fillcolor="#A6E7F4"];

    animal -> mammal [label="is-a"];
    animal -> dog [label="is-a"];
    animal -> cat [label="is-a"];
    dog -> fido [label="instance"];

