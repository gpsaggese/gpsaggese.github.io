  rankdir=LR;

  node [shape=box, style="rounded,filled", penwidth=1.4,
        fontname="Helvetica", fontsize=10, margin="0.14,0.09", height=0.4];
  edge [color="#A3B1C0", penwidth=1.1, arrowhead=vee, arrowsize=0.6,
