    Repr    [label="Internal\nRepresentation", fillcolor="#A6E7F4", color="#5FB0C4", fontcolor="#1F4E56"];
    Process [label="Cognitive\nProcesses", fillcolor="#A0D6D1", color="#4F9A8C", fontcolor="#1F4E45"];
