    next [label=<Next State<BR/>s<SUB>t+1</SUB>>, shape=ellipse, fillcolor="#A0D6D1", color="#00897B"];
    reward [label=<Reward<BR/>R(s', a, s)>, shape=diamond, fillcolor="#B2E2B2", color="#558B2F"];
