    s0 -> st;
    env -> st;
    env -> s0;

    st -> agent;
    action -> agent [style=invis];

    agent -> transition;
    transition -> next;
    next -> reward;
    reward -> goal;

    next -> st [constraint=false];

    { rank=min; s0; }
    { rank=same; env; st; }
